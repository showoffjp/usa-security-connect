# Copy to .env and fill in. Never commit the real file.

# --- required in production -------------------------------------------------
# Long random string. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
USC_JWT_SECRET=

# Where the web app is served from, so the API only accepts calls from it.
USC_ALLOWED_ORIGINS=https://connect.usasecuritygroup.com

# --- optional ---------------------------------------------------------------
PORT=4000
USC_TOKEN_TTL=12h

# Persistent disk for the SQLite file and incident photos. On Render/Railway
# this must point at a mounted volume, or data is lost on every deploy.
USC_DATA_DIR=/data

# Google geocoding for the location picker. Without it, address lookup falls
# back to OpenStreetMap, which needs no key.
USC_MAPS_API_KEY=

# Set to 1 to switch push delivery off (the test suite sets this).
USC_PUSH_DISABLED=
