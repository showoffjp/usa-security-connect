# Copy to .env and fill in. Never commit the real file.

# --- required in production -------------------------------------------------
# Long random string. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
USC_JWT_SECRET=

# Where the web app is served from, so the API only accepts calls from it.
USC_ALLOWED_ORIGINS=https://connect.usasecuritygroup.com

# --- optional ---------------------------------------------------------------
PORT=4000
USC_TOKEN_TTL=12h

# --- database ---------------------------------------------------------------
# Postgres connection string. Set this and the API uses Neon's serverless
# driver. Leave it unset and it falls back to PGlite, an embedded Postgres,
# which is what local development and the test suite use.
DATABASE_URL=

# --- storage ----------------------------------------------------------------
# Vercel Blob token for incident photos. Without it, photos are written to
# USC_DATA_DIR/uploads on local disk, which only works on a host with a disk.
BLOB_READ_WRITE_TOKEN=

# Where the local database and uploads live when not using Neon/Blob.
USC_DATA_DIR=

# --- scheduled work ---------------------------------------------------------
# Shared secret for POST /api/cron/sweep. Vercel Cron calls it on a schedule
# because a serverless function cannot keep an internal timer alive.
CRON_SECRET=

# Google geocoding for the location picker. Without it, address lookup falls
# back to OpenStreetMap, which needs no key.
USC_MAPS_API_KEY=

# Set to 1 to switch push delivery off (the test suite sets this).
USC_PUSH_DISABLED=
